            "value": "The last line you looked at"
          }
        }
      }
    },
    "La càpsula de dalt diu si vas en directe i fa quants segons s'ha actualitzat.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cápsula de arriba dice si vas en directo y cuántos segundos hace que se actualizó."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The capsule at the top tells you if data is live and how many seconds ago it updated."
          }
        }
      }
    },

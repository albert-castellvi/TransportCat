    "TransportCat no recull dades personals. La ubicació només es fa servir al dispositiu.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TransportCat no recoge datos personales. La ubicación solo se usa en el dispositivo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TransportCat collects no personal data. Location is only used on your device."
          }
        }
      }
    },
    "TransportCat és gratis i ho seguirà sent. Si vols donar suport al desenvolupament, ho agrairem molt — no desbloqueja res, és només suport.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TransportCat es gratis y lo seguirá siendo. Si quieres apoyar el desarrollo, te lo agradeceremos mucho: no desbloquea nada, es solo apoyo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TransportCat is free and will stay free. If you'd like to support development, we'd really appreciate it — it unlocks nothing, it's just support."
          }
        }
      }
    },

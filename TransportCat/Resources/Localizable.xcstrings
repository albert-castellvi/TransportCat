        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The star at the top saves it to your favourites."
          }
        }
      }
    },
    "L'idioma es tria a la Configuració de l'iPhone. Disponible en català, castellà i anglès.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma se elige en los Ajustes del iPhone. Disponible en catalán, castellano e inglés."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the language in iPhone Settings. Available in Catalan, Spanish and English."
          }
        }
      }
    },

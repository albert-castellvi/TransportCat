    "«A prop» llista les parades més properes amb el temps real.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Cerca» lista las paradas más cercanas con el tiempo real."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Nearby” lists the closest stops with live times."
          }
        }
      }
    },
    "«Avisa'm» t'avisa 1, 3 o 5 minuts abans que arribi el tren.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Avísame» te avisa 1, 3 o 5 minutos antes de que llegue el tren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Alert me” notifies you 1, 3 or 5 minutes before the train arrives."
          }
        }
      }
    },
    "«Segueix en directe» posa la compte enrere a la pantalla bloquejada i a la Dynamic Island.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sigue en directo» pone la cuenta atrás en la pantalla bloqueada y en la Dynamic Island."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Follow live” puts the countdown on the Lock Screen and in the Dynamic Island."
          }
        }
      }
    },

# Generated by XcodeGen — never commit.
*.xcodeproj

# Xcode user state and build output
xcuserdata/
DerivedData/
build/
*.hmap

# App packages / symbols (never upload or commit)
*.ipa
*.dSYM.zip
*.dSYM

# Secrets and signing material — never commit
.env
secrets.xcconfig
AuthKey_*.p8
*.p12
*.mobileprovision
private_keys/

# OS noise
.DS_Store

# Local TMB API captures (may contain session data)
DOC-TMB/
